<% content_for :title, "Kode Stack Demos" %>

<header class="mb-10">
  <h1 class="text-3xl font-semibold tracking-tight">Kode Stack Demos</h1>
  <p class="mt-2 text-slate-600">
    Rails <%= Rails::VERSION::STRING %> &middot; Hotwire (Turbo + Stimulus) &middot; PostgreSQL 16 &middot; Sidekiq on Redis,
    deployed to AWS App Runner from a container image. Three demos live behind the links below; synthetic data only.
  </p>
</header>

<section class="mb-12">
  <h2 class="mb-3 text-xs font-semibold uppercase tracking-wider text-slate-500">Demos</h2>
  <nav class="grid gap-3 sm:grid-cols-3">
    <% demos.each do |demo| %>
      <div class="rounded-lg bg-white p-4 ring-1 ring-slate-200">
        <a href="#" class="font-medium text-slate-900 hover:text-indigo-600" aria-disabled="true"><%= demo[:name] %></a>
        <p class="mt-1 text-sm text-slate-600"><%= demo[:blurb] %></p>
        <p class="mt-3 text-xs font-medium uppercase tracking-wide text-amber-700">Coming soon</p>
      </div>
    <% end %>
  </nav>
</section>

<section>
  <div class="mb-3 flex items-baseline justify-between">
    <h2 class="text-xs font-semibold uppercase tracking-wider text-slate-500">Stack status</h2>
    <%= button_to "Run heartbeat", heartbeat_path,
          class: "rounded-md bg-slate-900 px-3 py-1.5 text-sm font-medium text-white hover:bg-slate-700" %>
  </div>

  <%# Subscribing here is what proves Action Cable: HeartbeatJob replaces the
      panel below from inside a Sidekiq worker, with no page reload. %>
  <%= turbo_stream_from "status" %>
  <%= render "pages/status_panel", status: @status %>
</section>
