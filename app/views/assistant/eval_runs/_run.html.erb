<%# Rendered from the database; RunEvalsJob replaces it after every case. %>
<% badge = { "queued" => "badge", "running" => "badge-info", "done" => "badge-success", "failed" => "badge-danger" }.fetch(run.status, "badge") %>
<div id="<%= dom_id(run) %>" data-status="<%= run.status %>">
  <div class="card">
    <div class="flex flex-wrap items-center gap-3">
      <span class="<%= badge %>"><%= run.status %></span>
      <span class="text-sm text-slate-700">Prompt v<%= run.prompt_version.version %> · <%= run.adapter %></span>
      <span class="ml-auto text-sm tabular-nums text-slate-600"><%= run.cases_done %> / <%= run.cases_total %> cases</span>
    </div>
    <progress class="mt-3 h-2 w-full accent-indigo-600" max="<%= [ run.cases_total, 1 ].max %>" value="<%= run.cases_done %>"
              aria-label="Eval progress"><%= run.progress_percent %>%</progress>

    <% if run.cases_done.positive? %>
      <dl class="mt-4 grid grid-cols-2 gap-4 sm:grid-cols-4" id="eval_summary">
        <% [ [ "Pass rate", format("%.0f%%", run.pass_rate * 100) ],
             [ "Mean F1", format("%.3f", run.mean_f1) ],
             [ "Precision", format("%.3f", run.mean_precision) ],
             [ "Recall", format("%.3f", run.mean_recall) ] ].each do |label, value| %>
          <div>
            <dt class="section-label"><%= label %></dt>
            <dd class="mt-1 text-2xl font-semibold tabular-nums text-slate-900"><%= value %></dd>
          </div>
        <% end %>
      </dl>
      <div class="mt-3"><%= render "assistant/eval_runs/delta", run: run %></div>
    <% end %>
    <% if run.error.present? %><p class="mt-3 text-sm text-rose-700"><%= run.error %></p><% end %>
  </div>

  <% if run.eval_results.any? %>
    <div class="mt-6 overflow-x-auto rounded-lg bg-white ring-1 ring-slate-200">
      <table class="min-w-full divide-y divide-slate-100 text-sm">
        <thead class="text-left">
          <tr>
            <th class="section-label px-4 py-2">Case</th>
            <th class="section-label px-4 py-2">Expected</th>
            <th class="section-label px-4 py-2">Got</th>
            <th class="section-label px-4 py-2 text-right">F1</th>
            <th class="section-label px-4 py-2"></th>
          </tr>
        </thead>
        <tbody class="divide-y divide-slate-100">
          <% run.eval_results.each do |result| %>
            <tr class="align-top">
              <td class="px-4 py-2">
                <details>
                  <summary class="cursor-pointer text-slate-800"><%= result.eval_case.title %></summary>
                  <p class="mt-2 max-w-md text-xs leading-5 text-slate-600"><%= result.eval_case.note %></p>
                  <% result.suggestions.each do |s| %>
                    <p class="mt-1 max-w-md text-xs text-slate-500"><span class="font-mono"><%= s["code"] %></span>: “<%= s["evidence"] %>”</p>
                  <% end %>
                  <% if result.error.present? %><p class="mt-1 text-xs text-rose-700"><%= result.error %></p><% end %>
                </details>
              </td>
              <td class="px-4 py-2"><%= render "assistant/eval_runs/codes", result: result, codes: result.expected_codes, side: :expected %></td>
              <td class="px-4 py-2"><%= render "assistant/eval_runs/codes", result: result, codes: result.got_codes, side: :got %></td>
              <td class="px-4 py-2 text-right tabular-nums"><%= format("%.2f", result.f1) %></td>
              <td class="px-4 py-2"><span class="<%= result.passed ? "badge-success" : "badge-danger" %>"><%= result.passed ? "pass" : "fail" %></span></td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  <% end %>
</div>
