<% if local_assigns[:alert].present? %>
  <p class="rounded-md bg-rose-50 px-4 py-3 text-sm text-rose-800 ring-1 ring-rose-200"><%= alert %></p>
<% elsif local_assigns[:notice].present? %>
  <p class="rounded-md bg-emerald-50 px-4 py-3 text-sm text-emerald-800 ring-1 ring-emerald-200"><%= notice %></p>
<% end %>
