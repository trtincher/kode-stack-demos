<div id="review_shortcuts_legend" class="card mb-4" hidden data-review-shortcuts-target="legend">
  <h2 class="section-label mb-2">Keyboard shortcuts</h2>
  <dl class="grid grid-cols-[auto_1fr] gap-x-4 gap-y-1 text-sm">
    <dt><kbd>a</kbd></dt><dd>Approve (reviewer, chart in review)</dd>
    <dt><kbd>r</kbd></dt><dd>Jump to the return note (reviewer, chart in review)</dd>
    <dt><kbd>e</kbd></dt><dd>Edit the focused code row (Tab to a row first)</dd>
    <dt><kbd>?</kbd></dt><dd>Show or hide this legend</dd>
  </dl>
</div>
